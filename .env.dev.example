# ═════════════════════════════════════════════════════════════════════════════
# .env.dev.example — env for the LOCAL dev stack (docker-compose.dev.yml).
#
#   cp .env.dev.example .env.dev      # .env.dev is gitignored (.env.* / *.env)
#   # fill in DEV-SCOPED values (see DEV_LOCAL.md "generate dev secrets"), then:
#   make dev-up
#
# This is the FREE LOCAL MIRROR (WSL2 + Docker Desktop). It BUILDS every image
# from local source (no GHCR pull) and uses self-signed mkcert TLS — see
# DEV_LOCAL.md. Resources are namespaced `veldrix-localdev-*` so they NEVER
# collide with prod, the cloud-dev droplet, or the legacy root dev compose.
#
# RULES (Phase 5 §2):
#   • NAMES + placeholders only here. NEVER commit real secret values.
#   • Every secret is DEV-SCOPED and DISTINCT from prod. No value is shared.
#   • Synthetic data only. Do NOT reference e2e-test/.env.
# ═════════════════════════════════════════════════════════════════════════════

# ── App mode ──────────────────────────────────────────────────────────────────
# Build target is `development` (hot-reload, mounted source); CI/CD owns prod.
APP_ENV=development
LOG_LEVEL=INFO

# ── Compose profiles (FULL by default) ────────────────────────────────────────
# full : stub inference + observability (Prometheus/Grafana/pg-exporter). ~6-8 GB.
# lean : stub inference only (drop observability) for <16 GB machines.
#   full → COMPOSE_PROFILES=stub,observability   (make dev-up)
#   lean → COMPOSE_PROFILES=stub                 (make dev-up-lean)
COMPOSE_PROFILES=stub,observability

# ── Host port overrides (only if a port is already taken on your machine) ─────
# The stack talks over the docker network internally; these are host-side
# conveniences. Defaults dodge a native Postgres (5432→55432) and Apache (8080→8081).
# Uncomment + change any that still collide (see DEV_LOCAL.md "Ports").
# POSTGRES_HOST_PORT=55432
# TRAEFIK_DASHBOARD_PORT=8081
# TRAEFIK_HTTP_PORT=80
# TRAEFIK_HTTPS_PORT=443
# AUTH_HOST_PORT=8000
# CORE_HOST_PORT=8001
# CONNECTORS_HOST_PORT=8002
# UI_HOST_PORT=5000
# PROMETHEUS_HOST_PORT=9090
# GRAFANA_HOST_PORT=3001

# ── Hosts (locked dev subdomain scheme; mapped to 127.0.0.1 via /etc/hosts) ───
VELDRIX_API_HOST=api.dev.veldrixai.ca
VELDRIX_APP_HOST=dev.veldrixai.ca
VELDRIX_CORS_ORIGINS=https://dev.veldrixai.ca,https://api.dev.veldrixai.ca

# ── Postgres (LOCAL container + DEV creds — never resolves to a prod host) ─────
POSTGRES_USER=veldrix_dev
POSTGRES_PASSWORD=REPLACE_WITH_DISTINCT_DEV_DB_PASSWORD
POSTGRES_DB=veldrix_dev

# ── Secrets — ALL dev-scoped, ALL distinct from prod ──────────────────────────
# Generate fresh values (DEV_LOCAL.md §"Generate dev secrets"); do not reuse prod.
JWT_SECRET_KEY=REPLACE_WITH_DISTINCT_DEV_JWT_SECRET
VELDRIX_VAULT_KEY=REPLACE_WITH_BASE64_32_BYTE_DEV_KEY
STRIPE_CUSTOMER_HASH_KEY=REPLACE_WITH_BASE64_32_BYTE_DEV_KEY
CONNECTOR_ENCRYPTION_KEY=REPLACE_WITH_DEV_FERNET_KEY

# Internal service tokens — TWO distinct tokens exist (PARITY-CHECKLIST drift note):
#   VELDRIX_INTERNAL_API_KEY : core API gating + core->auth notifications (auth+core)
#   INTERNAL_SERVICE_TOKEN   : core->connectors audit/chain-health/mode (core+connectors)
VELDRIX_INTERNAL_API_KEY=REPLACE_WITH_DISTINCT_DEV_INTERNAL_API_KEY
INTERNAL_SERVICE_TOKEN=REPLACE_WITH_DISTINCT_DEV_SERVICE_TOKEN

# ── Observability ─────────────────────────────────────────────────────────────
GRAFANA_ADMIN_USER=admin
GRAFANA_ADMIN_PASSWORD=REPLACE_WITH_DISTINCT_DEV_GRAFANA_PASSWORD

# ── Inference seam — STUB by default (free, deterministic, network-free) ──────
# stub : core talks to the deterministic mock-inference container (no keys, no cost).
# live : set "live", fill real DEV-SCOPED provider keys/URLs, start WITHOUT the stub
#        profile, and point NVIDIA_API_BASE_URL at the real endpoint. See DEV_LOCAL.md.
VELDRIX_INFERENCE_MODE=stub
NVIDIA_API_BASE_URL=http://mock-inference:9009/v1
NVIDIA_API_KEY=stub-key
GROQ_API_KEY=stub-key
# Pillar model ids (labels only while stubbed; real ids when live):
VELDRIX_PILLAR_CONTENT_MODEL=meta/llama-guard-4-12b
VELDRIX_PILLAR_HALLUCINATION_MODEL=meta/llama-3.1-8b-instruct
VELDRIX_PILLAR_BIAS_MODEL=meta/llama-3.1-8b-instruct
VELDRIX_PILLAR_POLICY_MODEL=meta/llama-3.1-8b-instruct
VELDRIX_PILLAR_LEGAL_MODEL=meta/llama-3.1-8b-instruct
BEDROCK_PROXY_URL=
OSS_INFERENCE_URL=

# ── Billing (Stripe TEST mode only in dev) ────────────────────────────────────
STRIPE_SECRET_KEY=sk_test_REPLACE_WITH_DEV_TEST_KEY
STRIPE_PUBLISHABLE_KEY=pk_test_REPLACE_WITH_DEV_TEST_KEY
STRIPE_WEBHOOK_SECRET=whsec_REPLACE_WITH_DEV_TEST_SECRET
STRIPE_PRICE_GROW_MONTHLY=
STRIPE_PRICE_GROW_ANNUAL=
STRIPE_PRICE_SCALE_MONTHLY=
STRIPE_PRICE_SCALE_ANNUAL=

# ── Email (dev sender; blank RESEND_API_KEY = email send is a no-op locally) ──
RESEND_API_KEY=
EMAIL_FROM=noreply@dev.veldrixai.ca
EMAIL_FROM_NAME=VeldrixAI Dev
EMAIL_SUPPORT_ADDRESS=support@dev.veldrixai.ca

# ── OAuth (dev apps + dev callback URLs; blank = OAuth buttons inert locally) ─
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GITHUB_CLIENT_ID=
GITHUB_CLIENT_SECRET=
