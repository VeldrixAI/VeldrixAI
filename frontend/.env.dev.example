# ══════════════════════════════════════════════════════════════════════════════
# VeldrixAI Frontend — DEV environment (Vercel dev project + local dev)
#
#   cp frontend/.env.dev.example frontend/.env.local      # gitignored
#
# DRIFT GUARD (RECON bonus finding / PARITY-CHECKLIST C1): veldrix-api.ts:10-14
# falls back to the PROD api host when NEXT_PUBLIC_VELDRIX_CORE_API_URL is unset.
# So we set EVERY public URL var explicitly to the dev API host — the prod
# fallback can never fire. The same vars are set in Vercel by infra/terraform/
# vercel.tf and in the container by docker-compose.deploy.yml. Keep all three
# in sync. The fail-closed app fix is the tracked follow-up (PARITY-CHECKLIST C2).
# ══════════════════════════════════════════════════════════════════════════════

# ── Public (browser-visible) URLs — ALL set to dev, none left to default ──────
NEXT_PUBLIC_VELDRIX_CORE_API_URL=https://api.dev.veldrixai.ca
NEXT_PUBLIC_VELDRIX_CORE_URL=https://api.dev.veldrixai.ca
NEXT_PUBLIC_VELDRIX_AUTH_URL=https://api.dev.veldrixai.ca/auth
NEXT_PUBLIC_VELDRIX_CONNECTORS_URL=https://api.dev.veldrixai.ca
NEXT_PUBLIC_API_BASE=https://api.dev.veldrixai.ca
NEXT_PUBLIC_APP_URL=https://dev.veldrixai.ca
NEXT_PUBLIC_ENV=dev
NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY=pk_test_REPLACE_WITH_DEV_TEST_KEY

# ── Server-side (SSR) internal URLs ───────────────────────────────────────────
# In the Vercel dev project these point at the public dev API host. In the
# droplet container they are overridden to the in-network service URLs
# (http://veldrix-auth:8000 etc.) by docker-compose.deploy.yml.
VELDRIX_AUTH_API_URL=https://api.dev.veldrixai.ca
VELDRIX_CORE_API_URL=https://api.dev.veldrixai.ca
VELDRIX_CONNECTORS_API_URL=https://api.dev.veldrixai.ca

# ── Secrets (DEV-scoped; distinct from prod) ──────────────────────────────────
# Must match the auth service's dev JWT_SECRET_KEY. Generate a DISTINCT dev value:
#   python -c "import secrets; print(secrets.token_hex(32))"
JWT_SECRET=REPLACE_WITH_DISTINCT_DEV_JWT_SECRET
