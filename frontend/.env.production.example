# VeldrixAI Frontend — Production Secrets
# Server path: /opt/veldrixai/secrets/frontend.env
# Permissions: chmod 600 /opt/veldrixai/secrets/frontend.env
# ══════════════════════════════════════════════════════════════════════════════

JWT_SECRET=REPLACE_WITH_SAME_JWT_SECRET_AS_AUTH
# Generate: python3 -c "import secrets; print(secrets.token_hex(32))"

# Public URLs (accessible from browser for SSE and API calls)
NEXT_PUBLIC_VELDRIX_CORE_API_URL=http://localhost:8001
