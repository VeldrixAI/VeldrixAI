# ═════════════════════════════════════════════════════════════════════════════
# .env.deploy.example — env for docker-compose.deploy.yml (dev or prod).
#
#   cp .env.deploy.example .env.dev.deploy     # gitignored (*.env / .env.* ignored)
#   # fill in DEV-SCOPED values, then ship as /opt/veldrixai/.env (APPLY-RUNBOOK §4)
#
# RULES (Phase 5 §2):
#   • NAMES + placeholders only here. NEVER commit real secret values.
#   • Every secret is DEV-SCOPED and DISTINCT from prod. No value is shared.
#   • Do NOT reference e2e-test/.env.
# ═════════════════════════════════════════════════════════════════════════════

# ── Environment selector (drives volume/network/container names) ──────────────
ENVIRONMENT=dev
APP_ENV=production            # the container app-mode; dev env still runs prod images
LOG_LEVEL=INFO

# ── Hosts (mirrored dev subdomain scheme — locked decision #1) ────────────────
VELDRIX_API_HOST=api.dev.veldrixai.ca
VELDRIX_APP_HOST=dev.veldrixai.ca
VELDRIX_CORS_ORIGINS=https://dev.veldrixai.ca,https://api.dev.veldrixai.ca

# ── Image source (dev branch tag) ─────────────────────────────────────────────
DOCKER_REGISTRY=ghcr.io/veldrixai/veldrixai
IMAGE_TAG=dev

# ── Postgres (DEV instance + DEV creds — must NOT resolve to a prod host) ──────
POSTGRES_USER=veldrix_dev
POSTGRES_PASSWORD=REPLACE_WITH_DISTINCT_DEV_DB_PASSWORD
POSTGRES_DB=veldrix_dev

# ── Secrets — ALL dev-scoped, ALL distinct from prod ──────────────────────────
# Generate fresh values; do not reuse prod. Helper commands in DEV_ENVIRONMENT.md.
JWT_SECRET_KEY=REPLACE_WITH_DISTINCT_DEV_JWT_SECRET
VELDRIX_VAULT_KEY=REPLACE_WITH_BASE64_32_BYTE_DEV_KEY
STRIPE_CUSTOMER_HASH_KEY=REPLACE_WITH_BASE64_32_BYTE_DEV_KEY
CONNECTOR_ENCRYPTION_KEY=REPLACE_WITH_DEV_FERNET_KEY

# Internal service tokens — TWO distinct tokens exist (PARITY-CHECKLIST drift note):
#   VELDRIX_INTERNAL_API_KEY : core API gating + core->auth notifications (set on core+auth)
#   INTERNAL_SERVICE_TOKEN   : core->connectors audit/chain-health/mode (set on core+connectors)
VELDRIX_INTERNAL_API_KEY=REPLACE_WITH_DISTINCT_DEV_INTERNAL_API_KEY
INTERNAL_SERVICE_TOKEN=REPLACE_WITH_DISTINCT_DEV_SERVICE_TOKEN

# ── Observability ─────────────────────────────────────────────────────────────
GRAFANA_ADMIN_USER=admin
GRAFANA_ADMIN_PASSWORD=REPLACE_WITH_DISTINCT_DEV_GRAFANA_PASSWORD

# ── Inference seam — STUB by default (locked decision #3) ─────────────────────
# stub : core/connectors talk to the deterministic mock-inference service (free).
# live : set this to "live", fill the real DEV-SCOPED provider keys/URLs below,
#        and start WITHOUT the stub profile. See DEV_ENVIRONMENT.md "stub -> live".
VELDRIX_INFERENCE_MODE=stub
NVIDIA_API_BASE_URL=http://mock-inference:9009/v1
NVIDIA_API_KEY=stub-key
GROQ_API_KEY=stub-key
# Pillar model ids (used as labels by the stub; real ids when live):
VELDRIX_PILLAR_CONTENT_MODEL=meta/llama-guard-4-12b
VELDRIX_PILLAR_HALLUCINATION_MODEL=meta/llama-3.1-8b-instruct
VELDRIX_PILLAR_BIAS_MODEL=meta/llama-3.1-8b-instruct
VELDRIX_PILLAR_POLICY_MODEL=meta/llama-3.1-8b-instruct
VELDRIX_PILLAR_LEGAL_MODEL=meta/llama-3.1-8b-instruct
BEDROCK_PROXY_URL=
OSS_INFERENCE_URL=

# ── Billing (Stripe TEST mode only in dev) ────────────────────────────────────
STRIPE_SECRET_KEY=sk_test_REPLACE_WITH_DEV_TEST_KEY
STRIPE_PUBLISHABLE_KEY=pk_test_REPLACE_WITH_DEV_TEST_KEY
STRIPE_WEBHOOK_SECRET=whsec_REPLACE_WITH_DEV_TEST_SECRET
STRIPE_PRICE_GROW_MONTHLY=
STRIPE_PRICE_GROW_ANNUAL=
STRIPE_PRICE_SCALE_MONTHLY=
STRIPE_PRICE_SCALE_ANNUAL=

# ── Email (dev sender) ────────────────────────────────────────────────────────
RESEND_API_KEY=
EMAIL_FROM=noreply@dev.veldrixai.ca
EMAIL_FROM_NAME=VeldrixAI Dev
EMAIL_SUPPORT_ADDRESS=support@dev.veldrixai.ca

# ── OAuth (dev apps + dev callback URLs) ──────────────────────────────────────
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GITHUB_CLIENT_ID=
GITHUB_CLIENT_SECRET=
