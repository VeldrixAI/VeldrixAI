# ── Secrets & Environment ──────────────────────────────────────────────────────
.env
.env.*
*.env
!.env.example
!.env.dev.example
!.env.local.example
!.env.production.example
!.env.deploy.example
# Explicit allow for checked-in example files
!backend/.env.example
!backend/.env.dev.example
!backend/auth/.env.production.example
!backend/core/.env.production.example
!backend/connectors/.env.production.example
!frontend/.env.production.example
!frontend/.env.dev.example
!infra/compose/.env.deploy.example

# ── Python ────────────────────────────────────────────────────────────────────
__pycache__/
*.py[cod]
*.pyo
*.pyd
.Python
*.egg-info/
dist/
build/
.pytest_cache/
.mypy_cache/
.ruff_cache/
*.log
*.db
*.sqlite
*.sqlite3
.venv/
venv/
env/
Lib/
Scripts/
Include/
pyvenv.cfg
# NOTE: `Scripts/` above targets the Windows venv bin dir (already covered by
# `.venv/`), but with core.ignorecase=true it also shadows real project dirs like
# `infra/scripts/`. Re-include the infra scripts explicitly so they are tracked.
!infra/scripts/
!infra/scripts/**

# ── Node / Next.js ────────────────────────────────────────────────────────────
node_modules/
.next/
out/
.vercel/
frontend/tsconfig.tsbuildinfo
.turbo/

# ── Playwright / Test Artifacts ───────────────────────────────────────────────
test-results/
playwright-report/
frontend/tests/reports/html/
frontend/tests/reports/*.xml
frontend/tests/reports/*.json
# Allow gitkeep placeholders that preserve empty CI output dirs
!frontend/frontend/tests/reports/.gitkeep
!frontend/frontend/tests/screenshots/.gitkeep

# ── Certificates & Keys ───────────────────────────────────────────────────────
*.pem
*.key
*.p12
*.pfx
*.cert
*.crt
*.jks

# ── Misc ──────────────────────────────────────────────────────────────────────
*.zip
*.tar.gz
.DS_Store
Thumbs.db

# ── Editor / Windows junk ─────────────────────────────────────────────────────
.vscode/
nul
**/nul

# ── Design sources (kept locally for reference; NOT shipped to prod public/) ───
# The extracted production assets (veldrix-logo.png, etc.) are what ship.
frontend/public/Pillar Hero - standalone.html
frontend/public/VeldrixAI_logo_voidbg_2x.png
frontend/public/videoframe_23494.png
