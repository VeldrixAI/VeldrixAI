# ═══════════════════════════════════════════════════════════════════════════════
# VeldrixAI Production Environment Configuration
# ═══════════════════════════════════════════════════════════════════════════════
# Copy this file to .env.production and fill in the values.
# NEVER commit .env.production to version control.
# ═══════════════════════════════════════════════════════════════════════════════

# ── Database ──────────────────────────────────────────────────────────────────
POSTGRES_USER=veldrix
POSTGRES_PASSWORD=<YOUR_SECURE_POSTGRES_PASSWORD>
POSTGRES_DB=veldrix

# ── Security ───────────────────────────────────────────────────────────────────
# Generate: python -c "import secrets; print(secrets.token_urlsafe(32))"
JWT_SECRET=<YOUR_JWT_SECRET_32_BYTES>
VELDRIX_VAULT_KEY=<YOUR_BASE64_ENCODED_32_BYTE_KEY>
# Generate: python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
CONNECTOR_ENCRYPTION_KEY=<YOUR_FERNET_KEY>
STRIPE_CUSTOMER_HASH_KEY=<YOUR_BASE64_ENCODED_32_BYTE_KEY>

# ── NVIDIA NIM API ─────────────────────────────────────────────────────────────
NVIDIA_API_KEY=nvapi-xxx

# ── Groq API (for prompt generation) ──────────────────────────────────────────
GROQ_API_KEY=gsk_xxx

# ── Stripe (Billing) ───────────────────────────────────────────────────────────
STRIPE_SECRET_KEY=sk_live_xxx
STRIPE_WEBHOOK_SECRET=whsec_xxx

# ─-- CORS ──────────────────────────────────────────────────────────────────────
CORS_ORIGINS=https://veldrixai.ca,https://app.veldrixai.ca,https://api.veldrixai.ca

# ── Frontend Public URLs ───────────────────────────────────────────────────────
NEXT_PUBLIC_API_BASE=https://api.veldrixai.ca
NEXT_PUBLIC_APP_URL=https://app.veldrixai.ca
NEXT_PUBLIC_VELDRIX_CORE_URL=https://api.veldrixai.ca

# ── Let's Encrypt ──────────────────────────────────────────────────────────────
ACME_EMAIL=admin@veldrixai.ca

# ── Grafana ────────────────────────────────────────────────────────────────────
GRAFANA_ADMIN_USER=admin
GRAFANA_ADMIN_PASSWORD=<YOUR_GRAFANA_PASSWORD>