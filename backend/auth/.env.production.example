# ══════════════════════════════════════════════════════════════════════════════
# VeldrixAI Auth Service — Production Secrets
# Server path: /opt/veldrixai/secrets/auth.env
# Permissions: chmod 600 /opt/veldrixai/secrets/auth.env
# Owner:       chown root:root /opt/veldrixai/secrets/auth.env
#
# Generate secrets:
#   JWT:   python3 -c "import secrets; print(secrets.token_hex(32))"
#   Vault: python3 -c "import secrets,base64; print(base64.b64encode(secrets.token_bytes(32)).decode())"
# ══════════════════════════════════════════════════════════════════════════════

JWT_SECRET_KEY=REPLACE_WITH_STRONG_SECRET
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=60

STRIPE_SECRET_KEY=sk_live_REPLACE_WITH_LIVE_KEY
STRIPE_WEBHOOK_SECRET=whsec_REPLACE_WITH_LIVE_SECRET
STRIPE_PRICE_GROW_MONTHLY=price_REPLACE
STRIPE_PRICE_GROW_ANNUAL=price_REPLACE
STRIPE_PRICE_SCALE_MONTHLY=price_REPLACE
STRIPE_PRICE_SCALE_ANNUAL=price_REPLACE
VELDRIX_UI_URL=https://app.veldrixai.ca

VELDRIX_VAULT_KEY=REPLACE_WITH_BASE64_32_BYTE_KEY
STRIPE_CUSTOMER_HASH_KEY=REPLACE_WITH_BASE64_32_BYTE_KEY

RESEND_API_KEY=re_REPLACE_WITH_LIVE_KEY
EMAIL_FROM=noreply@veldrixai.ca
EMAIL_FROM_NAME=VeldrixAI
