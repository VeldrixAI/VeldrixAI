# ══════════════════════════════════════════════════════════════════════════════
# VeldrixAI — Development Environment
# Copy this file: cp backend/.env.dev.example backend/.env.dev
# This file is safe to commit — it contains only local dev defaults.
# NEVER put real production secrets here.
# ══════════════════════════════════════════════════════════════════════════════

# ── Database ──────────────────────────────────────────────────────────────────
# Overridden by docker-compose.yml to use the postgres container hostname.
DATABASE_URL=postgresql+psycopg2://veldrix:veldrix_dev_password@localhost:5432/veldrix_dev
POSTGRES_USER=veldrix
POSTGRES_PASSWORD=veldrix_dev_password
POSTGRES_DB=veldrix_dev

# ── JWT ───────────────────────────────────────────────────────────────────────
JWT_SECRET_KEY=dev-only-jwt-secret-not-for-production-change-me
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=60

# ── Application ───────────────────────────────────────────────────────────────
APP_ENV=development

# ── NVIDIA NIM ────────────────────────────────────────────────────────────────
# Get a free key at: https://developer.nvidia.com/
NVIDIA_API_KEY=nvapi-REPLACE_WITH_YOUR_DEV_KEY
NVIDIA_API_BASE_URL=https://integrate.api.nvidia.com/v1

# ── Per-pillar model assignments ──────────────────────────────────────────────
VELDRIX_PILLAR_CONTENT_MODEL=meta/llama-guard-4-12b
VELDRIX_PILLAR_HALLUCINATION_MODEL=meta/llama-3.1-8b-instruct
VELDRIX_PILLAR_BIAS_MODEL=meta/llama-3.1-8b-instruct
VELDRIX_PILLAR_POLICY_MODEL=meta/llama-3.1-8b-instruct
VELDRIX_PILLAR_LEGAL_MODEL=meta/llama-3.1-8b-instruct
VELDRIX_NIM_TIMEOUT_MS=8000
VELDRIX_MAX_INPUT_CHARS=2000

# ── Groq fallback (optional for dev) ─────────────────────────────────────────
GROQ_API_KEY=gsk_REPLACE_WITH_YOUR_DEV_KEY

# ── Bedrock / OSS (leave blank for dev) ──────────────────────────────────────
BEDROCK_PROXY_URL=
BEDROCK_API_KEY=
BEDROCK_MODEL_ID=anthropic.claude-3-haiku-20240307-v1:0
OSS_INFERENCE_URL=
OSS_API_KEY=
OSS_MODEL_ID=llama3.1:8b

# ── Circuit Breaker ───────────────────────────────────────────────────────────
CIRCUIT_FAILURE_THRESHOLD=5
CIRCUIT_RECOVERY_TIMEOUT=60
CIRCUIT_HALF_OPEN_SUCCESS_REQUIRED=2
CIRCUIT_BREAKER_BACKEND=memory
REDIS_URL=redis://localhost:6379/0

# ── Internal service auth ─────────────────────────────────────────────────────
VELDRIX_INTERNAL_API_KEY=dev-internal-key-not-for-production
VELDRIX_AUTH_URL=http://localhost:8000
VELDRIX_CONNECTORS_URL=http://localhost:8002

# ── CORS ──────────────────────────────────────────────────────────────────────
VELDRIX_CORS_ORIGINS=http://localhost:3000,http://localhost:5000

# ── Stripe (use test keys only) ───────────────────────────────────────────────
STRIPE_SECRET_KEY=sk_test_REPLACE_WITH_YOUR_TEST_KEY
STRIPE_WEBHOOK_SECRET=whsec_REPLACE_WITH_YOUR_TEST_SECRET
STRIPE_PRICE_GROW_MONTHLY=
STRIPE_PRICE_GROW_ANNUAL=
STRIPE_PRICE_SCALE_MONTHLY=
STRIPE_PRICE_SCALE_ANNUAL=
VELDRIX_UI_URL=http://localhost:5000

# ── AES-256 Vault ─────────────────────────────────────────────────────────────
# Dev key — safe to use locally, rotate for production.
# Generate your own: python -c "import secrets,base64; print(base64.b64encode(secrets.token_bytes(32)).decode())"
VELDRIX_VAULT_KEY=REPLACE_WITH_BASE64_32_BYTE_KEY_FOR_DEV
STRIPE_CUSTOMER_HASH_KEY=REPLACE_WITH_BASE64_32_BYTE_KEY_FOR_DEV

# ── Connector encryption (Fernet) ────────────────────────────────────────────
# Generate: python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
CONNECTOR_ENCRYPTION_KEY=REPLACE_WITH_FERNET_KEY_FOR_DEV

# ── Frontend ──────────────────────────────────────────────────────────────────
JWT_SECRET=dev-only-jwt-secret-not-for-production-change-me
