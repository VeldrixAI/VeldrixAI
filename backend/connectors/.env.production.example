CONNECTOR_ENCRYPTION_KEY=REPLACE_WITH_FERNET_KEY
# Generate: python3 -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"

VELDRIX_INTERNAL_API_KEY=REPLACE_WITH_SAME_KEY_AS_CORE
