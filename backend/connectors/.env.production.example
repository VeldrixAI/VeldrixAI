# ══════════════════════════════════════════════════════════════════════════════
# VeldrixAI Connectors Service — Production Secrets
# Server path: /opt/veldrixai/secrets/connectors.env
# Permissions: chmod 600 /opt/veldrixai/secrets/connectors.env
# ══════════════════════════════════════════════════════════════════════════════

CONNECTOR_ENCRYPTION_KEY=REPLACE_WITH_FERNET_KEY
# Generate: python3 -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"

VELDRIX_INTERNAL_API_KEY=REPLACE_WITH_SAME_KEY_AS_CORE

# ── Transactional Email (Resend) ──────────────────────────────────────────────
# Must match the RESEND_API_KEY used by the auth service (same Resend account).
RESEND_API_KEY=re_REPLACE_WITH_LIVE_KEY
EMAIL_FROM=noreply@veldrixai.ca
EMAIL_FROM_NAME=VeldrixAI
EMAIL_SUPPORT_ADDRESS=rudramani031@veldrixai.ca
VELDRIX_UI_URL=https://app.veldrixai.ca
