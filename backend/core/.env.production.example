# ══════════════════════════════════════════════════════════════════════════════
# VeldrixAI Core Service — Production Secrets
# Server path: /opt/veldrixai/secrets/core.env
# Permissions: chmod 600 /opt/veldrixai/secrets/core.env
# ══════════════════════════════════════════════════════════════════════════════

JWT_SECRET_KEY=REPLACE_WITH_SAME_JWT_SECRET_AS_AUTH

NVIDIA_API_KEY=nvapi-REPLACE_WITH_LIVE_KEY
NVIDIA_API_BASE_URL=https://integrate.api.nvidia.com/v1

# Per-pillar model matrix — read by backend/core/src/config/pillar_models.py.
# Heavyweight defaults ship in code (Llama Guard 4 / Nemotron 3 Ultra 550B /
# Mistral Large 3 675B / Nemotron Ultra 253B / Llama 3.1 405B).
# Uncomment to override; full field list documented in pillar_models.py.
# VELDRIX_PILLAR_MODEL__SAFETY__PRIMARY=meta/llama-guard-4-12b
# VELDRIX_PILLAR_MODEL__HALLUCINATION__PRIMARY=nvidia/nemotron-3-ultra-550b-a55b
# VELDRIX_PILLAR_MODEL__BIAS__PRIMARY=mistralai/mistral-large-3-675b-instruct-2512
# VELDRIX_PILLAR_MODEL__PROMPT_SECURITY__PRIMARY=nvidia/llama-3.1-nemotron-ultra-253b-v1
# VELDRIX_PILLAR_MODEL__COMPLIANCE__PRIMARY=meta/llama-3.1-405b-instruct

# Engine determinism — strict provider priority + pinned seed (default on).
VELDRIX_DETERMINISTIC_ROUTING=true
VELDRIX_INFERENCE_SEED=42
VELDRIX_MAX_INPUT_CHARS=2000

GROQ_API_KEY=gsk_REPLACE_WITH_LIVE_KEY

BEDROCK_PROXY_URL=
BEDROCK_API_KEY=
BEDROCK_MODEL_ID=anthropic.claude-3-haiku-20240307-v1:0

OSS_INFERENCE_URL=
OSS_API_KEY=
OSS_MODEL_ID=llama3.1:8b

CIRCUIT_FAILURE_THRESHOLD=5
CIRCUIT_RECOVERY_TIMEOUT=60
CIRCUIT_HALF_OPEN_SUCCESS_REQUIRED=2
CIRCUIT_BREAKER_REDIS_KEY_PREFIX=veldrix:cb
CIRCUIT_BREAKER_FALLBACK_AFTER_FAILURES=5

VELDRIX_INTERNAL_API_KEY=REPLACE_WITH_STRONG_SECRET
