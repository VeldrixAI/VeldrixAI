# Copy this file to  .env  and fill in your real keys.
# .env is gitignored — never commit real keys.

# VeldrixAI API key from the dashboard (must start with vx-live- or vx-test-)
VELDRIX_API_KEY=vx-live-REPLACE_WITH_YOUR_KEY


# Your OpenAI API key (the agent makes a real gpt-4o-mini call)
OPENAI_API_KEY=sk-proj-REPLACE_WITH_YOUR_KEY

# Optional — defaults to production. Override to point at a local backend.
# VELDRIX_BASE_URL=http://localhost:8000
